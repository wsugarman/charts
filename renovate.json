{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "constraints": {
    "ghActionsLock": "v0.4.1"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the gh-actions-lock extension used by Renovate and CI workflows to regenerate and verify .github/workflows/actions.lock",
      "managerFilePatterns": [
        "/^renovate\\.json$/"
      ],
      "matchStrings": [
        "\"ghActionsLock\":\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "github/gh-actions-lock",
      "datasourceTemplate": "github-releases"
    }
  ]
}
